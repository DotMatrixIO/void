{
  "name": "@workspace/void-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "node scripts/check-repo-url.mjs && node scripts/sync-fragments.mjs && vite build --config vite.config.ts && node scripts/gen-og-rewrites.mjs && node scripts/gen-og-pages.mjs && node scripts/add-sri.mjs && node scripts/add-modulepreload-sri.mjs && node scripts/gen-sw-known-hashes.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "pnpm -w run typecheck:libs && tsc -b tsconfig.json && tsc -p tsconfig.test.json",
    "test": "PORT=${PORT:-5173} BASE_PATH=${BASE_PATH:-/} VITE_VOID_ONION_HOST=${VITE_VOID_ONION_HOST:-voidexampleabcd234567abcd234567abcd234567abcd234567abcde.onion} pnpm run build && vitest run --config vitest.config.ts",
    "test:fast": "vitest run --config vitest.config.ts",
    "check:phrases": "node scripts/check-banned-phrases.mjs",
    "check:literals": "node scripts/check-required-literals.mjs",
    "check:feature-policy-sync": "node scripts/check-feature-policy-sync.mjs",
    "check:onion-mirror-sync": "node scripts/check-onion-mirror-sync.mjs",
    "check:release-onion-bake": "node scripts/check-release-onion-bake.mjs",
    "check:still-poster": "node scripts/check-still-poster.mjs",
    "check:biometric-video-drift": "node scripts/check-biometric-video-drift.mjs",
    "check:biometric-poster-drift": "node scripts/check-biometric-poster-drift.mjs",
    "update:biometric-poster": "node scripts/check-biometric-poster-drift.mjs --update-reference",
    "check:og-routes": "node scripts/check-og-routes-parity.mjs",
    "check:routes-overview": "node scripts/check-routes-overview-drift.mjs",
    "check:nav-routes": "node scripts/check-nav-routes-drift.mjs",
    "check:fragments-sync": "node scripts/check-fragments-sync.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:ink-surface": "node scripts/check-ink-surface.mjs",
    "check:no-display-media-audio": "node scripts/check-no-display-media-audio.mjs",
    "check:signaling-envelope": "node scripts/check-signaling-envelope.mjs",
    "check:doc-code-drift": "node scripts/check-doc-code-drift.mjs",
    "check:security-key-fingerprint": "node scripts/check-security-key-fingerprint.mjs",
    "check:log-ip-room-correlation": "node scripts/check-log-ip-room-correlation.mjs",
    "check:payment-hash-log": "node scripts/check-payment-hash-log.mjs",
    "check:threat-model-drift": "node scripts/check-threat-model-drift.mjs",
    "check:landing-fonts": "node scripts/check-landing-fonts.mjs",
    "check:room-not-session": "node scripts/check-room-not-session.mjs",
    "check:publish-doc-hygiene": "node scripts/check-publish-doc-hygiene.mjs",
    "check:publish-cross-links": "node scripts/check-publish-cross-links.mjs",
    "check:launch-links": "node scripts/check-launch-checklist-links.mjs",
    "test:playwright": "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1 PORT=${PORT:-5173} BASE_PATH=${BASE_PATH:-/} playwright test --config playwright.config.ts",
    "test:playwright:devicecloud": "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1 playwright test --config playwright.devicecloud.config.ts",
    "gen:og": "node scripts/gen-og-images.mjs",
    "gen:still-poster": "node scripts/gen-still-poster.mjs",
    "gen:demo-posters": "node scripts/gen-demo-posters.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "axe-core": "^4.11.4",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "jsdom": "^29.1.0",
    "puppeteer-core": "^24.42.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "^0.34.5",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.1.4",
    "wawoff2": "^2.0.1",
    "wouter": "^3.3.5",
    "zod": "catalog:"
  },
  "dependencies": {
    "@workspace/wire-core": "workspace:*",
    "@workspace/signaling-types": "workspace:*",
    "hash-wasm": "^4.12.0",
    "qr-scanner": "1.4.2",
    "qrcode.react": "^4.2.0",
    "socket.io-client": "^4.8.3"
  }
}

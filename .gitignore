# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# attached_assets is the agent/scratch staging area (pasted notes, brainstorming
# docs, internal drafts). NOTHING here is imported by any source — the @assets
# Vite alias had no live importer and has been removed — so the whole tree is
# excluded from version control. It is kept on local disk but must never reach
# the public repo. Files committed before this exclusion are untracked via
# `git rm --cached` and drop out of the publish snapshot (see the internal
# launch-decisions doc, "Tree decision").
attached_assets/

# Local environment / secrets — never commit. Real secrets belong in the
# platform secret store (or the operator's env), not in the tree. See the
# internal secret-scan doc.
.env
.env.local
.env.development
.env.production
.env.test
.env.*

# pnpm content-addressable store, if it ever lands inside the workspace.
.pnpm-store/

# Private, non-public working docs that must stay out of the published tree.
docs/_private/

# Coturn — operator copies turnserver.conf.example to turnserver.conf and
# fills in their real static-auth-secret. That file MUST NOT be committed
# (it would put a real TURN secret in git). The API server additionally
# refuses to start with the example placeholder, but keeping the operator's
# real config out of version control is the first line of defense.
coturn/turnserver.conf
artifacts/api-server/data/rooms.json
artifacts/api-server/data/rooms.json

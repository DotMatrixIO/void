{
  "name": "workspace",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "lint": "eslint -c eslint.config.mjs",
    "lint:secrets": "eslint -c eslint.config.mjs --rule '{\"@workspace/secrets/no-secret-equality\":\"error\"}'",
    "test:lint-rules": "pnpm --filter @workspace/eslint-plugin-secrets test",
    "sbom": "cyclonedx-pnpm --output-format JSON --output-file sbom.cdx.json"
  },
  "private": true,
  "engines": {
    "node": "22.12.0",
    "pnpm": "10.26.1"
  },
  "packageManager": "pnpm@10.26.1",
  "pnpm": {

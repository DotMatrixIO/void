modules = ["nodejs-24", "python-3.11"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-server-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "void-client-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "demo-video-embed-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "smoke-serve-static"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "still-poster-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "void-client-playwright"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "biometric-video-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "biometric-poster-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "safari-webrtc-devicecloud"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "void-client-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-server-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mockup-sandbox-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "biometric-demo-video-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "log-ip-room-correlation"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "marketing-voice"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "payment-hash-log"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "overview-http-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "publish-doc-hygiene"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "startos-compat"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "publish-doc-crosslinks"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "publish-boundary"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "wire-protocol-name"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "publish-inventory"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check:pnpm-action-version"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-publish-inventory"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-mockup-codegen-safe"

[[workflows.workflow]]
name = "api-server-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "void-client-tests"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "STRICT_SRI=1 pnpm --filter @workspace/void-client run test"

[[workflows.workflow]]
name = "demo-video-embed-tests"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/void-client exec vitest run --config vitest.config.ts DemoVideoEmbed"

[[workflows.workflow]]
name = "smoke-serve-static"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run smoke:serve-static"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "still-poster-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/void-client run check:still-poster"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "void-client-playwright"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1 PORT=5173 BASE_PATH=/ pnpm --filter @workspace/void-client exec playwright test --config playwright.config.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "biometric-video-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/void-client run check:biometric-video-drift"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "biometric-poster-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/void-client run check:biometric-poster-drift"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "safari-webrtc-devicecloud"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/void-client run test:playwright:devicecloud"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "void-client-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/void-client run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-server-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "mockup-sandbox-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "biometric-demo-video-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/biometric-demo-video run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "log-ip-room-correlation"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/void-client run check:log-ip-room-correlation"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "marketing-voice"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/void-client run check:phrases && pnpm --filter @workspace/void-client run check:literals && pnpm --filter @workspace/void-client run check:feature-policy-sync && pnpm --filter @workspace/void-client run check:onion-mirror-sync && pnpm --filter @workspace/void-client run check:og-routes && pnpm --filter @workspace/void-client run check:routes-overview && pnpm --filter @workspace/void-client run check:nav-routes && pnpm --filter @workspace/void-client run check:fragments-sync && pnpm --filter @workspace/void-client run check:contrast && pnpm --filter @workspace/void-client run check:ink-surface && pnpm --filter @workspace/void-client run check:no-display-media-audio && pnpm --filter @workspace/void-client run check:signaling-envelope && pnpm --filter @workspace/void-client run check:doc-code-drift && pnpm --filter @workspace/void-client run check:security-key-fingerprint && pnpm --filter @workspace/void-client run check:threat-model-drift && pnpm --filter @workspace/void-client run check:landing-fonts && pnpm --filter @workspace/void-client run check:room-not-session && pnpm --filter @workspace/void-client run check:launch-links"

[[workflows.workflow]]
name = "payment-hash-log"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/void-client run check:payment-hash-log"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "overview-http-drift"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-spec run check-overview-http && pnpm --filter @workspace/api-spec run check-overview-asyncapi"

[[workflows.workflow]]
name = "publish-doc-hygiene"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/void-client run check:publish-doc-hygiene"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "startos-compat"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run smoke:startos-compat"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "publish-doc-crosslinks"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/void-client run check:publish-cross-links"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "publish-boundary"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check:publish-boundary"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "wire-protocol-name"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check:wire-protocol-name"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "publish-inventory"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check:publish-inventory"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check:pnpm-action-version"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check:pnpm-action-version"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-publish-inventory"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run test:publish-inventory"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-mockup-codegen-safe"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run test:mockup-codegen-safe"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]

[userenv.development]
ENABLE_AGENT_ROOMS = "1"
PAYWALL_JITTER_DISABLE = "1"
